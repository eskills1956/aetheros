#!/bin/bash
# Aether OS Developer Tools - Various development utilities

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Determine script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AETHEROS_TOP="$(cd "$SCRIPT_DIR/.." && pwd)"

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Show usage
show_usage() {
    cat << EOF
Aether OS Developer Tools

Usage: aether-dev <command> [options]

Commands:
  shell            Open ADB shell on device
  install <apk>    Install application to device
  uninstall <pkg>  Uninstall application from device
  screenshot       Take screenshot from device
  screenrecord     Record device screen
  pull <src> <dst> Pull file from device
  push <src> <dst> Push file to device
  reboot           Reboot device
  info             Show device information
  benchmark        Run performance benchmarks
  test             Run system tests

Examples:
  aether-dev shell                    # Open shell
  aether-dev install app.apk          # Install app
  aether-dev screenshot screen.png    # Take screenshot
  aether-dev info                     # Show device info

EOF
}

# Check for adb
check_adb() {
    if ! command -v adb &> /dev/null; then
        log_error "adb not found. Please install android-tools"
        exit 1
    fi
}

# Check device
check_device() {
    if ! adb devices | grep -q "device$"; then
        log_error "No device connected"
        exit 1
    fi
}

# Open shell
do_shell() {
    log_info "Opening ADB shell..."
    adb shell
}

# Install app
do_install() {
    local apk="$1"
    if [ -z "$apk" ]; then
        log_error "APK file required"
        exit 1
    fi

    if [ ! -f "$apk" ]; then
        log_error "File not found: $apk"
        exit 1
    fi

    log_info "Installing $apk..."
    adb install "$apk"
    log_success "Installation complete"
}

# Uninstall app
do_uninstall() {
    local package="$1"
    if [ -z "$package" ]; then
        log_error "Package name required"
        exit 1
    fi

    log_info "Uninstalling $package..."
    adb uninstall "$package"
    log_success "Uninstall complete"
}

# Take screenshot
do_screenshot() {
    local output="${1:-screenshot.png}"

    log_info "Taking screenshot..."
    adb shell screencap -p /sdcard/screenshot.png
    adb pull /sdcard/screenshot.png "$output"
    adb shell rm /sdcard/screenshot.png
    log_success "Screenshot saved to: $output"
}

# Screen record
do_screenrecord() {
    local output="${1:-screenrecord.mp4}"
    local duration="${2:-180}"

    log_info "Recording screen (max ${duration}s, Ctrl+C to stop)..."
    adb shell screenrecord --time-limit "$duration" /sdcard/screenrecord.mp4 &
    local pid=$!

    # Wait for user to stop or timeout
    wait $pid 2>/dev/null || true

    log_info "Pulling recording..."
    adb pull /sdcard/screenrecord.mp4 "$output"
    adb shell rm /sdcard/screenrecord.mp4
    log_success "Recording saved to: $output"
}

# Pull file
do_pull() {
    local src="$1"
    local dst="$2"

    if [ -z "$src" ]; then
        log_error "Source path required"
        exit 1
    fi

    log_info "Pulling $src..."
    adb pull "$src" "$dst"
    log_success "Pull complete"
}

# Push file
do_push() {
    local src="$1"
    local dst="$2"

    if [ -z "$src" ] || [ -z "$dst" ]; then
        log_error "Source and destination paths required"
        exit 1
    fi

    if [ ! -e "$src" ]; then
        log_error "File not found: $src"
        exit 1
    fi

    log_info "Pushing $src to $dst..."
    adb push "$src" "$dst"
    log_success "Push complete"
}

# Reboot device
do_reboot() {
    local mode="${1:-normal}"

    case "$mode" in
        normal)
            log_info "Rebooting device..."
            adb reboot
            ;;
        bootloader|fastboot)
            log_info "Rebooting to bootloader..."
            adb reboot bootloader
            ;;
        recovery)
            log_info "Rebooting to recovery..."
            adb reboot recovery
            ;;
        *)
            log_error "Unknown reboot mode: $mode"
            exit 1
            ;;
    esac
}

# Show device info
do_info() {
    echo "======================================"
    echo "  Device Information"
    echo "======================================"
    echo ""

    log_info "Device properties:"
    echo ""

    # Device model and manufacturer
    echo "Model:        $(adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
    echo "Manufacturer: $(adb shell getprop ro.product.manufacturer 2>/dev/null | tr -d '\r')"
    echo "Device:       $(adb shell getprop ro.product.device 2>/dev/null | tr -d '\r')"
    echo ""

    # OS version
    echo "OS Version:   $(adb shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')"
    echo "Build ID:     $(adb shell getprop ro.build.id 2>/dev/null | tr -d '\r')"
    echo "SDK Level:    $(adb shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r')"
    echo ""

    # Hardware info
    echo "CPU ABI:      $(adb shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r')"
    echo "Screen:       $(adb shell wm size 2>/dev/null | grep 'Physical' | cut -d: -f2 | tr -d '\r')"
    echo "Density:      $(adb shell wm density 2>/dev/null | grep 'Physical' | cut -d: -f2 | tr -d '\r')"
    echo ""

    # Battery info
    echo "Battery:      $(adb shell dumpsys battery | grep level | cut -d: -f2 | tr -d ' \r')%"
    echo "Charging:     $(adb shell dumpsys battery | grep 'AC powered' | cut -d: -f2 | tr -d ' \r')"
    echo ""

    # Storage
    echo "Storage:"
    adb shell df -h /data | tail -1 | awk '{print "  /data:  "$3" used of "$2" ("$5" used)"}'
    echo ""
}

# Run benchmarks
do_benchmark() {
    echo "======================================"
    echo "  Performance Benchmarks"
    echo "======================================"
    echo ""

    log_info "Running CPU benchmark..."
    # Simple CPU benchmark
    adb shell "time cat /dev/zero | head -c 100M | md5sum" 2>&1 | grep real

    echo ""
    log_info "Running storage benchmark..."
    adb shell "time dd if=/dev/zero of=/data/local/tmp/test bs=1M count=100 && rm /data/local/tmp/test" 2>&1 | grep "copied"

    echo ""
    log_success "Benchmark complete"
}

# Run tests
do_test() {
    log_info "Running system tests..."

    cd "$AETHEROS_TOP"

    if [ -x tests/integration/test_system_services.sh ]; then
        bash tests/integration/test_system_services.sh
    else
        log_error "Test script not found"
        exit 1
    fi
}

# Main
echo "======================================"
echo "  Aether OS Developer Tools"
echo "======================================"
echo ""

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    shell)
        check_adb
        check_device
        do_shell
        ;;
    install)
        check_adb
        check_device
        do_install "$@"
        ;;
    uninstall)
        check_adb
        check_device
        do_uninstall "$@"
        ;;
    screenshot)
        check_adb
        check_device
        do_screenshot "$@"
        ;;
    screenrecord)
        check_adb
        check_device
        do_screenrecord "$@"
        ;;
    pull)
        check_adb
        check_device
        do_pull "$@"
        ;;
    push)
        check_adb
        check_device
        do_push "$@"
        ;;
    reboot)
        check_adb
        check_device
        do_reboot "$@"
        ;;
    info)
        check_adb
        check_device
        do_info
        ;;
    benchmark)
        check_adb
        check_device
        do_benchmark
        ;;
    test)
        do_test
        ;;
    help|--help|-h)
        show_usage
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        show_usage
        exit 1
        ;;
esac
