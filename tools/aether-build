#!/bin/bash
# Aether OS Build Tool - Unified build interface

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Determine script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AETHEROS_TOP="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source environment
if [ -f "$AETHEROS_TOP/build/envsetup.sh" ]; then
    source "$AETHEROS_TOP/build/envsetup.sh" >/dev/null
fi

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Show usage
show_usage() {
    cat << EOF
Aether OS Build Tool

Usage: aether-build [command] [options]

Commands:
  all              Build complete system (default)
  kernel           Build kernel only
  system           Build system services
  apps             Build applications
  image            Create flashable image
  sdk              Build SDK
  clean            Clean build artifacts
  distclean        Clean everything including downloads

  component <name> Build specific component
  config           Configure build options
  info             Show build information

Options:
  -j, --jobs <n>   Number of parallel jobs (default: $(nproc))
  -v, --verbose    Verbose output
  -h, --help       Show this help message

Examples:
  aether-build all               # Build everything
  aether-build kernel -j8        # Build kernel with 8 jobs
  aether-build component audio   # Build audio service only
  aether-build clean             # Clean build artifacts

EOF
}

# Show build info
show_info() {
    echo "======================================"
    echo "  Aether OS Build Information"
    echo "======================================"
    echo ""
    echo "Project Root:      $AETHEROS_TOP"
    echo "Version:           $AETHEROS_VERSION"
    echo "Codename:          $AETHEROS_CODENAME"
    echo "Build Type:        $AETHEROS_BUILD_TYPE"
    echo "Target Arch:       $AETHEROS_TARGET_ARCH"
    echo "Output Dir:        $AETHEROS_OUT"
    echo "Parallel Jobs:     $PARALLEL_JOBS"
    echo ""
    echo "Components:"
    echo "  Kernel:          $AETHEROS_KERNEL"
    echo "  Compositor:      $AETHEROS_COMPOSITOR"
    echo "  System:          $AETHEROS_SYSTEM"
    echo "  Apps:            $AETHEROS_APPS"
    echo ""
}

# Build commands
build_all() {
    log_info "Building complete Aether OS system..."
    cd "$AETHEROS_TOP"
    make all -j"${JOBS:-$PARALLEL_JOBS}"
    log_success "Build complete!"
}

build_kernel() {
    log_info "Building kernel..."
    cd "$AETHEROS_TOP"
    make kernel -j"${JOBS:-$PARALLEL_JOBS}"
    log_success "Kernel build complete!"
}

build_system() {
    log_info "Building system services..."
    cd "$AETHEROS_TOP"
    make system -j"${JOBS:-$PARALLEL_JOBS}"
    log_success "System build complete!"
}

build_apps() {
    log_info "Building applications..."
    cd "$AETHEROS_TOP"
    make apps -j"${JOBS:-$PARALLEL_JOBS}"
    log_success "Apps build complete!"
}

build_image() {
    log_info "Creating system image..."
    cd "$AETHEROS_TOP"
    make image
    log_success "Image created!"
}

build_sdk() {
    log_info "Building SDK..."
    cd "$AETHEROS_TOP"
    make sdk -j"${JOBS:-$PARALLEL_JOBS}"
    log_success "SDK build complete!"
}

clean_build() {
    log_info "Cleaning build artifacts..."
    cd "$AETHEROS_TOP"
    make clean
    log_success "Clean complete!"
}

distclean_build() {
    log_warning "This will remove all build artifacts and downloads!"
    read -p "Are you sure? (y/N): " confirm
    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        log_info "Performing distclean..."
        cd "$AETHEROS_TOP"
        rm -rf out/* downloads/*
        log_success "Distclean complete!"
    else
        log_info "Cancelled"
    fi
}

build_component() {
    local component="$1"
    if [ -z "$component" ]; then
        log_error "Component name required"
        exit 1
    fi

    log_info "Building component: $component"

    case "$component" in
        display|audio|power|network)
            cd "$AETHEROS_TOP"
            make -C "src/system/$component" -j"${JOBS:-$PARALLEL_JOBS}"
            log_success "Component $component built!"
            ;;
        compositor)
            cd "$AETHEROS_TOP"
            make -C src/compositor -j"${JOBS:-$PARALLEL_JOBS}"
            log_success "Compositor built!"
            ;;
        libaether)
            cd "$AETHEROS_TOP"
            make -C src/frameworks/flutter/libaether -j"${JOBS:-$PARALLEL_JOBS}"
            log_success "libaether built!"
            ;;
        *)
            log_error "Unknown component: $component"
            log_info "Available components: display, audio, power, network, compositor, libaether"
            exit 1
            ;;
    esac
}

configure_build() {
    log_info "Build configuration:"
    echo ""
    echo "Current configuration can be modified in:"
    echo "  $AETHEROS_TOP/aetheros.config"
    echo ""
    echo "Or set environment variables:"
    echo "  AETHEROS_BUILD_TYPE=eng|user|userdebug"
    echo "  AETHEROS_TARGET_ARCH=arm64|arm|x86_64"
    echo ""
}

# Parse arguments
COMMAND="${1:-all}"
shift || true

JOBS=""
VERBOSE=""

while [ $# -gt 0 ]; do
    case "$1" in
        -j|--jobs)
            JOBS="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE="1"
            shift
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        *)
            COMPONENT_ARG="$1"
            shift
            ;;
    esac
done

# Execute command
case "$COMMAND" in
    all)
        build_all
        ;;
    kernel)
        build_kernel
        ;;
    system)
        build_system
        ;;
    apps)
        build_apps
        ;;
    image)
        build_image
        ;;
    sdk)
        build_sdk
        ;;
    clean)
        clean_build
        ;;
    distclean)
        distclean_build
        ;;
    component)
        build_component "$COMPONENT_ARG"
        ;;
    config)
        configure_build
        ;;
    info)
        show_info
        ;;
    help|--help|-h)
        show_usage
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        echo ""
        show_usage
        exit 1
        ;;
esac
