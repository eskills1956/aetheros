[Unit]
Description=Aether OS Network Service
Documentation=man:aether-network-service(8)
After=basic.target sysinit.target
Before=network-online.target
Wants=network.target
ConditionPathExists=/usr/bin/aether-network-service

[Service]
Type=simple
ExecStart=/usr/bin/aether-network-service
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=10

# Capabilities for network management
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /sys/class/net /sys/class/bluetooth

# Resource limits
MemoryMax=256M
CPUQuota=30%

# Watchdog
WatchdogSec=30

[Install]
WantedBy=multi-user.target network.target
Alias=network.service
