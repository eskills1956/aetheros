#!/bin/bash
# Aether OS Service Manager
# Manages lifecycle of Aether OS system services

set -e

# Configuration
SERVICE_DIR="/etc/aetheros/services"
STATE_DIR="/run/aetheros"
LOG_FILE="/var/log/aether-service-manager.log"

# Service list
SERVICES=(
    "aether-power"
    "aether-network"
    "aether-audio"
    "aether-display"
    "aether-compositor"
)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1" | tee -a "$LOG_FILE"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" | tee -a "$LOG_FILE"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG_FILE"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1" | tee -a "$LOG_FILE"
}

# Initialize
init() {
    mkdir -p "$STATE_DIR"
    mkdir -p "$(dirname "$LOG_FILE")"

    log_info "Aether OS Service Manager starting..."
    log_info "Version: 1.0.0"
    log_info "PID: $$"
}

# Check service status
check_service() {
    local service="$1"
    systemctl is-active --quiet "$service.service" && return 0 || return 1
}

# Start service
start_service() {
    local service="$1"

    log_info "Starting $service..."

    if check_service "$service"; then
        log_warning "$service is already running"
        return 0
    fi

    if systemctl start "$service.service"; then
        log_success "$service started"
        echo "$(date +%s)" > "$STATE_DIR/$service.started"
        return 0
    else
        log_error "Failed to start $service"
        return 1
    fi
}

# Stop service
stop_service() {
    local service="$1"

    log_info "Stopping $service..."

    if ! check_service "$service"; then
        log_warning "$service is not running"
        return 0
    fi

    if systemctl stop "$service.service"; then
        log_success "$service stopped"
        rm -f "$STATE_DIR/$service.started"
        return 0
    else
        log_error "Failed to stop $service"
        return 1
    fi
}

# Restart service
restart_service() {
    local service="$1"

    log_info "Restarting $service..."

    if systemctl restart "$service.service"; then
        log_success "$service restarted"
        echo "$(date +%s)" > "$STATE_DIR/$service.restarted"
        return 0
    else
        log_error "Failed to restart $service"
        return 1
    fi
}

# Get service status
status_service() {
    local service="$1"

    echo "Service: $service"
    systemctl status "$service.service" --no-pager || true
    echo ""
}

# Start all services
start_all() {
    log_info "Starting all Aether OS services..."

    local failed=0

    for service in "${SERVICES[@]}"; do
        if ! start_service "$service"; then
            failed=$((failed + 1))
        fi
        sleep 1
    done

    if [ $failed -eq 0 ]; then
        log_success "All services started successfully"
        return 0
    else
        log_error "$failed service(s) failed to start"
        return 1
    fi
}

# Stop all services
stop_all() {
    log_info "Stopping all Aether OS services..."

    # Stop in reverse order
    for ((i=${#SERVICES[@]}-1; i>=0; i--)); do
        stop_service "${SERVICES[$i]}"
        sleep 1
    done

    log_success "All services stopped"
}

# Restart all services
restart_all() {
    log_info "Restarting all Aether OS services..."
    stop_all
    sleep 2
    start_all
}

# Status of all services
status_all() {
    echo "======================================"
    echo "  Aether OS Services Status"
    echo "======================================"
    echo ""

    for service in "${SERVICES[@]}"; do
        status_service "$service"
    done
}

# Reload configuration
reload_config() {
    log_info "Reloading service configurations..."
    systemctl daemon-reload
    log_success "Configuration reloaded"
}

# Health check
health_check() {
    log_info "Performing health check..."

    local healthy=0
    local unhealthy=0

    for service in "${SERVICES[@]}"; do
        if check_service "$service"; then
            log_success "$service: healthy"
            healthy=$((healthy + 1))
        else
            log_error "$service: unhealthy"
            unhealthy=$((unhealthy + 1))
        fi
    done

    echo ""
    echo "Health Summary: $healthy healthy, $unhealthy unhealthy"

    if [ $unhealthy -gt 0 ]; then
        return 1
    fi

    return 0
}

# Main
main() {
    init

    case "${1:-}" in
        start)
            start_all
            ;;
        stop)
            stop_all
            ;;
        restart)
            restart_all
            ;;
        reload)
            reload_config
            ;;
        status)
            status_all
            ;;
        health)
            health_check
            ;;
        enable)
            log_info "Enabling Aether OS services..."
            for service in "${SERVICES[@]}"; do
                systemctl enable "$service.service"
            done
            log_success "Services enabled"
            ;;
        disable)
            log_info "Disabling Aether OS services..."
            for service in "${SERVICES[@]}"; do
                systemctl disable "$service.service"
            done
            log_success "Services disabled"
            ;;
        *)
            echo "Aether OS Service Manager"
            echo ""
            echo "Usage: $0 {start|stop|restart|reload|status|health|enable|disable}"
            echo ""
            echo "Commands:"
            echo "  start    - Start all Aether OS services"
            echo "  stop     - Stop all Aether OS services"
            echo "  restart  - Restart all Aether OS services"
            echo "  reload   - Reload service configurations"
            echo "  status   - Show status of all services"
            echo "  health   - Perform health check"
            echo "  enable   - Enable services to start at boot"
            echo "  disable  - Disable services from starting at boot"
            exit 1
            ;;
    esac
}

main "$@"
