#!/bin/bash
# Aether OS System Startup Script
# Runs during early boot to initialize the system

set -e

# Configuration
LOG_FILE="/var/log/aether-startup.log"
STATE_DIR="/run/aetheros"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Logging
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1" | tee -a "$LOG_FILE"
}

log_success() {
    echo -e "${GREEN}[OK]${NC} $1" | tee -a "$LOG_FILE"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG_FILE"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1" | tee -a "$LOG_FILE"
}

# Print banner
print_banner() {
    clear
    cat << 'EOF'
    _         _   _               ___  ____
   / \   ___ | |_| |__   ___ _ __/ _ \/ ___|
  / _ \ / _ \| __| '_ \ / _ \ '__| | | \___ \
 / ___ \  __/| |_| | | |  __/ |  | |_| |___) |
/_/   \_\___| \__|_| |_|\___|_|   \___/|____/

        Aether OS v1.0.0 - Aurora
EOF
    echo ""
}

# Initialize system
init_system() {
    log_info "Initializing Aether OS..."

    # Create state directory
    mkdir -p "$STATE_DIR"
    mkdir -p "$(dirname "$LOG_FILE")"

    # Set hostname
    if [ -f /etc/hostname ]; then
        hostname $(cat /etc/hostname)
        log_success "Hostname set: $(hostname)"
    fi

    # Set timezone
    if [ -L /etc/localtime ]; then
        log_success "Timezone: $(readlink /etc/localtime | sed 's|/usr/share/zoneinfo/||')"
    fi

    echo "$(date +%s)" > "$STATE_DIR/boot_time"
}

# Check filesystem
check_filesystems() {
    log_info "Checking filesystems..."

    # Check root filesystem
    if mountpoint -q /; then
        log_success "Root filesystem mounted"
    else
        log_error "Root filesystem not mounted"
        return 1
    fi

    # Check /data partition
    if [ -b /dev/mmcblk0p3 ]; then
        if ! mountpoint -q /data; then
            log_info "Mounting /data partition..."
            mount /dev/mmcblk0p3 /data 2>/dev/null || log_warning "Failed to mount /data"
        fi
        if mountpoint -q /data; then
            log_success "/data partition mounted"
        fi
    fi

    # Check /cache partition
    if [ -d /cache ]; then
        chmod 770 /cache
        log_success "Cache directory ready"
    fi
}

# Load kernel modules
load_modules() {
    log_info "Loading kernel modules..."

    local modules=(
        "ext4"
        "vfat"
        "overlay"
        "squashfs"
    )

    for module in "${modules[@]}"; do
        if modprobe "$module" 2>/dev/null; then
            log_success "Loaded: $module"
        else
            log_warning "Failed to load: $module"
        fi
    done
}

# Initialize devices
init_devices() {
    log_info "Initializing devices..."

    # Set up /dev/shm
    if ! mountpoint -q /dev/shm; then
        mount -t tmpfs tmpfs /dev/shm 2>/dev/null || true
    fi

    # Set permissions
    chmod 1777 /tmp
    chmod 755 /var
    chmod 755 /run

    # Create device nodes if needed
    [ -e /dev/null ] || mknod -m 666 /dev/null c 1 3
    [ -e /dev/zero ] || mknod -m 666 /dev/zero c 1 5
    [ -e /dev/random ] || mknod -m 444 /dev/random c 1 8
    [ -e /dev/urandom ] || mknod -m 444 /dev/urandom c 1 9

    log_success "Devices initialized"
}

# Set up networking
init_network() {
    log_info "Initializing network..."

    # Bring up loopback
    if ip link set lo up 2>/dev/null; then
        log_success "Loopback interface up"
    fi

    # Set up hostname
    hostname aetheros 2>/dev/null || true
}

# Initialize graphics
init_graphics() {
    log_info "Initializing graphics..."

    # Set up DRM/KMS
    if [ -d /sys/class/drm ]; then
        log_success "DRM subsystem available"
    fi

    # Set up framebuffer
    if [ -e /dev/fb0 ]; then
        chmod 660 /dev/fb0
        log_success "Framebuffer device ready"
    fi
}

# Load configuration
load_config() {
    log_info "Loading system configuration..."

    # Load default config
    if [ -f /etc/aetheros/aetheros.conf ]; then
        source /etc/aetheros/aetheros.conf
        log_success "System configuration loaded"
    fi

    # Load service config
    if [ -f /etc/aetheros/services.conf ]; then
        log_success "Service configuration loaded"
    fi
}

# Check boot mode
check_boot_mode() {
    # Check for recovery mode
    if grep -q "recovery" /proc/cmdline 2>/dev/null; then
        log_warning "Booting in RECOVERY mode"
        echo "recovery" > "$STATE_DIR/boot_mode"
        return 1
    fi

    # Check for safe mode
    if grep -q "safe" /proc/cmdline 2>/dev/null; then
        log_warning "Booting in SAFE mode"
        echo "safe" > "$STATE_DIR/boot_mode"
        return 2
    fi

    echo "normal" > "$STATE_DIR/boot_mode"
    log_success "Boot mode: NORMAL"
    return 0
}

# Set up runtime directories
setup_runtime() {
    log_info "Setting up runtime directories..."

    # Create XDG runtime directory
    mkdir -p /run/user/1000
    chmod 700 /run/user/1000
    chown 1000:1000 /run/user/1000 2>/dev/null || true

    # Create Wayland runtime
    mkdir -p /run/wayland
    chmod 755 /run/wayland

    log_success "Runtime directories ready"
}

# Cleanup old state
cleanup_state() {
    log_info "Cleaning up old state..."

    # Remove stale PID files
    find /run -name "*.pid" -type f -delete 2>/dev/null || true

    # Clean /tmp if needed
    if [ -d /tmp ]; then
        find /tmp -type f -atime +7 -delete 2>/dev/null || true
    fi

    log_success "State cleanup complete"
}

# Report system info
report_info() {
    log_info "System Information:"
    log "  Kernel: $(uname -r)"
    log "  Architecture: $(uname -m)"
    log "  Memory: $(free -h | awk '/^Mem:/ {print $2}')"
    log "  Uptime: $(cut -d' ' -f1 /proc/uptime)s"
}

# Main
main() {
    print_banner

    log "======================================"
    log "  Aether OS System Startup"
    log "  $(date)"
    log "======================================"
    log ""

    init_system
    check_boot_mode
    check_filesystems
    load_modules
    init_devices
    init_network
    init_graphics
    setup_runtime
    load_config
    cleanup_state
    report_info

    log ""
    log_success "System startup complete!"
    log ""

    # Mark startup as complete
    touch "$STATE_DIR/startup_complete"
    echo "$(date +%s)" > "$STATE_DIR/startup_time"
}

main "$@"
